# Supabase Postgres connection - copy from your Supabase project settings
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password

# Shared secrets - each must match the corresponding caller (the Collector
# bot, the frontend, and the EventBridge-scheduled internal triggers)
RECORD_PRICE_SECRET=your-record-price-secret
FORECAST_SNAPSHOT_SECRET=your-forecast-snapshot-secret
INTERNAL_TRIGGER_SECRET=your-internal-trigger-secret
WATCHDOG_SECRET=your-watchdog-secret

# Supabase project URL (same as NEXT_PUBLIC_SUPABASE_URL) - used to fetch its
# JWKS endpoint for verifying login tokens on the me query
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Optional - defaults to enabled. Set to "false" to match production, where
# it's turned off so the deployed schema isn't publicly browsable.
# GRAPHQL_INTROSPECTION_ENABLED=true
